# Copy to .env and fill in. NEVER commit .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database -----------------------------------------------------------------
# Local:  postgresql://localhost:5432/vasooli
# Railway/Neon: paste their URL as-is; the driver prefix is normalized in config.py
DATABASE_URL=postgresql://localhost:5432/vasooli
DB_ECHO=false

# --- Razorpay (test mode) -----------------------------------------------------
# Dashboard > Settings > API Keys. Smart Collect must be enabled on the account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks — must match the secret set there exactly.
RAZORPAY_WEBHOOK_SECRET=
# Seconds between API calls. Raise if you still see 'Too many requests'.
RAZORPAY_MIN_REQUEST_INTERVAL_SECONDS=1.5

# --- Gemini (Google AI Studio) ------------------------------------------------
GOOGLE_API_KEY=
# Verify these IDs against what your key actually serves before Phase 6.
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
# No DNS setup needed. Only delivers to the address the Resend account uses.
EMAIL_FROM=Vasooli <onboarding@resend.dev>
EMAIL_REPLY_TO_DOMAIN=example.com
RESEND_INBOUND_WEBHOOK_SECRET=
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
# Send every reminder here instead of to the customer. Required to send live.
# Points reminder mail at a specific inbox instead of the customer's address. The
# Settings panel can override this at runtime (DEMO_CONTROLS_ENABLED), but only ever
# to move it — never to disable redirection and start mailing the seeded ledger.
EMAIL_REDIRECT_TO=
# Keep true until Phase 7 exit criteria pass. Guards against emailing real people.
EMAIL_DRY_RUN=true
ALLOW_DIRECT_CUSTOMER_EMAIL=false
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Ops ----------------------------------------------------------------------
SCHEDULER_ENABLED=true
OPS_HEARTBEAT_URL=
OPS_RECOVERY_HEARTBEAT_URL=
ADMIN_API_KEY=
# Session signing key. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
CORS_ORIGINS=http://localhost:3000

# --- Demo controls (Phase 8) --------------------------------------------------
# Must be 0 in production; enforced at startup.
DEMO_TIME_OFFSET_DAYS=0

# --- Inbound email (real customer replies) ----------------------------------
# Replies are addressed to invoice-<number>@EMAIL_REPLY_TO_DOMAIN. That domain must
# be verified in Resend AND carry Resend's MX record, or replies reach nobody.
EMAIL_REPLY_TO_DOMAIN=yourdomain.com
# Resend -> Webhooks -> your inbound endpoint -> Signing Secret
RESEND_INBOUND_WEBHOOK_SECRET=

# The demo control that injects a reply no customer ever sent. Leave false. The real
# path is POST /api/webhooks/resend/inbound, which requires a signature and correlates
# the sender against the invoice thread.
ALLOW_SIMULATED_REPLIES=false

# --- Demo controls ----------------------------------------------------------
# Enables the simulated clock: /api/demo/advance moves the date forward so the
# 3/10/21-day cadence can be walked in a couple of minutes instead of three weeks.
# Every move is audited and the dashboard shows both the simulated and the real
# date whenever the offset is not zero. Leave false for a real merchant deployment.
DEMO_CONTROLS_ENABLED=false
