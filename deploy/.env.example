# Backend environment. Copy to deploy/.env on the server and fill in.
#   cp .env.example .env && chmod 600 .env
# deploy/.env is gitignored. Keep it that way.

# --- Host -------------------------------------------------------------------
# Must already point at this box's public IP before the first `docker compose up`,
# or Caddy cannot complete the ACME challenge.
DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- Database ---------------------------------------------------------------
# For docker-compose.prod.yml, DATABASE_URL is composed from the three local values.
# For docker-compose.rds.yml, set an sslmode=require RDS URL and leave local Postgres unused.
# Owner/migration role. Used ONLY by `alembic upgrade head`, never by the app.
DATABASE_URL=
# The role the application connects as: same host and database, user `vasooli_app`.
# Example: postgresql://vasooli_app:<APP_DB_PASSWORD>@<host>:5432/vasooli?sslmode=require
APP_DATABASE_URL=
# Generate: openssl rand -base64 24
POSTGRES_USER=vasooli
POSTGRES_PASSWORD=
POSTGRES_DB=vasooli

# The role the APPLICATION connects as. Not the owner above.
#
# Superusers and table owners bypass row-level security, so connecting the app as
# POSTGRES_USER leaves every forced RLS policy inert — tenant isolation and the
# demo/live boundary then rest entirely on application code. `vasooli_app` is
# NOSUPERUSER/NOBYPASSRLS, so the policies actually apply to it.
#
# Create it once, after the first migration:
#   docker compose -f docker-compose.prod.yml exec -T db \
#     psql -U vasooli -d vasooli -v app_password="'<this value>'" \
#     -f /path/to/backend/scripts/create_app_role.sql
#
# Generate: openssl rand -base64 24
APP_DB_PASSWORD=

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true

# One box, one scheduler. Leave true on exactly one host.
SCHEDULER_ENABLED=true
PROCESS_ROLE=api
WORKER_KIND=all
WORKER_POLL_SECONDS=15
DEMO_TIME_OFFSET_DAYS=0

# --- Razorpay ---------------------------------------------------------------
# The webhook secret must match what you set in the Razorpay dashboard for
# https://<DOMAIN>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LIVE_TRIAL_DAYS=7
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/live/payment-connections/oauth/callback
RAZORPAY_OAUTH_MODE=live
RAZORPAY_TIMEOUT_SECONDS=10
ALLOW_LIVE_RAZORPAY=false

# --- AI ---------------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Email ------------------------------------------------------------------
# Outbound and inbound share these two values, so they are defined once, here.
# Replies are addressed to invoice-<number>@EMAIL_REPLY_TO_DOMAIN. That domain must be
# verified in Resend AND carry Resend's MX record, or customer replies reach nobody.
RESEND_API_KEY=
EMAIL_FROM=Vasooli <onboarding@resend.dev>
AUTH_EMAIL_FROM=Vasooli <noreply@vasooli.com>
EMAIL_REPLY_TO_DOMAIN=replies.yourdomain.com
# Resend -> Webhooks -> your inbound endpoint -> Signing Secret.
#
# Resend issues a SEPARATE signing secret per webhook endpoint — not one shared
# across the account. RESEND_INBOUND_WEBHOOK_SECRET verifies email.received only;
# RESEND_DELIVERY_WEBHOOK_SECRET below verifies delivery/bounce events on the
# other endpoint, and using either value for the other endpoint fails that
# endpoint's signature check silently (a wrong-secret 400 looks identical to any
# other malformed request in the logs).
RESEND_INBOUND_WEBHOOK_SECRET=
EMAIL_PROVIDER_TIMEOUT_SECONDS=10

# SAFETY NET. The seeded demo ledger contains customer addresses. With DRY_RUN false
# and REDIRECT_TO empty, one recovery cycle emails all of them for real. Keep
# REDIRECT_TO pointed at your own inbox until you have deliberately decided otherwise.
EMAIL_DRY_RUN=false
FRONTEND_PUBLIC_URL=https://yourdomain.com
# Enable only after Resend delivery and the HTTPS public URL have passed preflight.
LIVE_REGISTRATION_ENABLED=false
# Keep this operator inbox configured for the demo ledger. With direct live delivery
# enabled below, live reminders instead use the customer email stored on the invoice.
EMAIL_REDIRECT_TO=you@yourdomain.com
ALLOW_DIRECT_CUSTOMER_EMAIL=true
# Enable only when EMAIL_FROM is on a domain verified in Resend.
ALLOW_PLATFORM_SENDER_FOR_LIVE=false
GLOBAL_SEND_KILL_SWITCH=false
GLOBAL_DAILY_SEND_QUOTA=100000

# Resend -> Webhooks -> your DELIVERY endpoint (a separate webhook from inbound) ->
# Signing Secret. Verifies email.delivered / email.bounced / email.delivery_delayed /
# email.complained on POST /api/webhooks/resend/delivery.
RESEND_DELIVERY_WEBHOOK_SECRET=

# Optional custom normalizer in addition to the native Resend endpoint.
INBOUND_EMAIL_WEBHOOK_SECRET=

# Optional off-host backup destination, e.g. s3://your-private-bucket/vasooli.
BACKUP_S3_URI=
BACKUP_S3_KMS_KEY_ID=
REQUIRE_OFFSITE_BACKUP=true

# Secret dead-man URLs (for example Healthchecks.io). The second check is pinged only
# after the daily recovery job succeeds, so a silently stopped job raises an alert.
OPS_HEARTBEAT_URL=
OPS_RECOVERY_HEARTBEAT_URL=

# --- Inbound email (real customer replies) ----------------------------------
# EMAIL_REPLY_TO_DOMAIN and RESEND_INBOUND_WEBHOOK_SECRET are set once in the Email
# section above. They were previously repeated here with different placeholder values,
# which meant the file contradicted itself and whichever line came last silently won.
#
# The demo control that injects a reply no customer ever sent. Leave false. The real
# path is POST /api/webhooks/resend/inbound, which requires a signature and correlates
# the sender against the invoice thread.
ALLOW_SIMULATED_REPLIES=false

# --- Access -----------------------------------------------------------------
# ADMIN_API_KEY: openssl rand -hex 32   (service scripts only; never goes to Vercel)
# SESSION_SECRET: openssl rand -hex 32  (use this exact value in Vercel too)
ADMIN_API_KEY=
SESSION_SECRET=

# Encrypts merchant Razorpay credentials at rest. REQUIRED in staging/production —
# startup fails without it. Must be distinct from SESSION_SECRET: rotating that one
# revokes sessions, and if the two were shared that rotation would also make every
# stored merchant credential permanently undecryptable.
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=

# --- Zoho Books --------------------------------------------------------------
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/live/integrations/zoho/oauth/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_OAUTH_SCOPE=ZohoBooks.invoices.READ,ZohoBooks.settings.READ
FRONTEND_LIVE_INTEGRATIONS_URL=https://app.yourdomain.com/live/integrations

# REQUIRED, and functional — not defence in depth.
#
# This comment used to say browsers never call this host directly, which was true when
# only the demo existed: those requests are proxied server-side by Vercel and never see
# CORS. The live layer is different. Sign-in, registration and every /api/live call go
# straight from the page to this host, so an origin missing here fails the preflight
# and the user sees an opaque "Failed to fetch" with nothing to act on.
#
# List every origin the app is served from, comma-separated and with no trailing slash
# — the apex and www are different origins, as are http and https.
CORS_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# --- Reviewer access --------------------------------------------------------
# Lets anyone reaching the login page open a READ-ONLY session without a credential
# being emailed to them. The account named below must already exist and must have the
# `auditor` role — the endpoint refuses to issue a session for anything else, so a
# mistyped name fails closed rather than handing out write access.
#   uv run python -m scripts.manage_operator create reviewer \
#     --display-name "Read-only reviewer" --role auditor
REVIEWER_ACCESS_ENABLED=false
REVIEWER_USERNAME=reviewer

# --- Demo controls ----------------------------------------------------------
# Enables the simulated clock: /api/demo/advance moves the date forward so the
# 3/10/21-day cadence can be walked in a couple of minutes instead of three weeks.
# Every move is audited and the dashboard shows both the simulated and the real
# date whenever the offset is not zero. Leave false for a real merchant deployment.
DEMO_CONTROLS_ENABLED=false
