# NOTE: this pattern used to be `Docs/`, which on a case-insensitive
# filesystem (macOS) also matched `docs/` — silently excluding every
# document in the project from the repository. The README linked to
# files a fresh clone did not contain.
#
# Only the personal scratch directory is ignored now.
Docs-private/

# Secrets — must stay first-class ignored, before any key is ever pasted.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js (Phase 10)
node_modules/
.next/
frontend/out/

# Local data + eval output
**/eval/out/
*.log

# OS / Editor / Tools
.DS_Store
.claude/

# Deployment secrets — never committed.
deploy/.env
deploy/*.env
# Local database dumps may contain customer data and credentials in extension
# objects; they are operational artifacts, never source artifacts.
deploy/backups/
.vercel
